        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|showLabel|key|ref|className|style|children)$/]",
        "message": "<StatusIndicator> doesn't accept that prop. Declared props: state, label, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:saved|syncing|unsaved|error|readonly)$/]",
        "message": "<StatusIndicator> state must be one of 'saved' | 'syncing' | 'unsaved' | 'error' | 'readonly'."
      },
      {
