      {
        "selector": "JSXOpeningElement[name.name='Link'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cta|hyperlink|title|nav)$/]",
        "message": "<Link> variant must be one of 'cta' | 'hyperlink' | 'title' | 'nav'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|symbolOnly|variant|as|key|ref|className|style|children)$/]",
