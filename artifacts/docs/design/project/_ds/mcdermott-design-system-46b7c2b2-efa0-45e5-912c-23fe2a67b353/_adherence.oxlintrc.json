        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|sectionLabel|pinned|children|open|onClose|className|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: header, sectionLabel, pinned, children, open, onClose, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|footer|children|className|key|ref|className|style|children)$/]",
        "message": "<SideSheet> doesn't accept that prop. Declared props: open, onClose, title, footer, children, className."
      },
