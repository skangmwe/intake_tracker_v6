        "message": "<Lockup> variant must be one of 'light' | 'onNavy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|a|div)$/]",
        "message": "<Lockup> as must be one of 'span' | 'a' | 'div'."
