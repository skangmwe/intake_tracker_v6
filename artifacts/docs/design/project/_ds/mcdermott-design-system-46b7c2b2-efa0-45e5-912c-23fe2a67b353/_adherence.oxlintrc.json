      {
        "selector": "JSXOpeningElement[name.name='PermissionPrompt'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|onApprove|onCancel|approveLabel|cancelLabel|key|ref|className|style|children)$/]",
