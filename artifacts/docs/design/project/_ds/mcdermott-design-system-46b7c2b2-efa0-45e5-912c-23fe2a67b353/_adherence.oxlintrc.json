        "message": "<Switch> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Table'] > JSXAttribute > JSXIdentifier[name!=/^(?:toolbar|pagination|minWidth|className|children|key|ref|className|style|children)$/]",
        "message": "<Table> doesn't accept that prop. Declared props: toolbar, pagination, minWidth, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabDef'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabDef> doesn't accept that prop. Declared props: id, label."
