<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>McDermott.AiTracker.Worker</RootNamespace>
    <AssemblyName>McDermott.AiTracker.Worker</AssemblyName>
    <UserSecretsId>ai-tracker-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Slice 1 adds Azure.Messaging.ServiceBus + Serilog. Kept minimal in scaffold. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
