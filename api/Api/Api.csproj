<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress "missing XML doc" warnings until per-symbol comments land. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- NEVER set InvariantGlobalization=true on this project. See api-coding-standards.md
         (Globalization). Microsoft.Data.SqlClient's LCID lookup throws under invariant
         mode and no database connection can be opened. -->
    <RootNamespace>McDermott.AiTracker.Api</RootNamespace>
    <AssemblyName>McDermott.AiTracker.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework references — kept minimal in scaffold. Slice 1 (Foundation) adds
         EF Core, Serilog with App Insights, Azure SDKs, and Microsoft.Identity.Web.
         Swagger/Swashbuckle is deferred until a slice that needs it adds the pinned
         Microsoft.OpenApi override that patches GHSA-v5pm-xwqc-g5wc. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <!-- Attachments streaming to Blob Storage via Managed Identity (slice 11,
         api-blob-attachments.md). Version verified against the live NuGet registry
         (latest stable 12.29.1). -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <!-- CSV parse (import) — RFC-4180 quoting/escaping handled for us (slice 16,
         BS §13). Version verified against the live NuGet registry (latest stable
         33.1.0); MIT, no known high/critical advisories. -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- Entra ID token validation for the SPA/API (api-auth.md). Version verified
         against the live NuGet registry during slice 2 (latest stable 4.12.2). -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.12.2" />
    <!-- AI-assist layer (Phase 4, api-llm-auth.md). Versions verified against the live
         NuGet registry 2026-07-25. `Anthropic` is the OFFICIAL .NET SDK ("The official
         .NET library for the Anthropic API") — not the community `Anthropic.SDK`. Claude
         is the default chat provider (MaxRetries=3); OpenAI is the alt chat provider;
         Azure.AI.OpenAI drives embeddings via the project's Azure OpenAI deployment (MI). -->
    <PackageReference Include="Anthropic" Version="12.39.0" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="5.0.1" />
  </ItemGroup>

</Project>
