{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Server=(localdb)\\MSSQLLocalDB;Database=AiSolutionsTracker;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ServiceBus": {
    "Namespace": "",
    "TopicName": "event-spine"
  },
  "Storage": {
    "BlobAccountUri": "",
    "ContainerName": "attachments",
    "LocalRootPath": ""
  },
  "Attachments": {
    "MaxFileBytes": 26214400,
    "ContentTypeAllowlist": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "text/plain",
      "text/csv",
      "image/png",
      "image/jpeg",
      "image/gif"
    ]
  },
  "ImportExport": {
    "MaxFileBytes": 5242880,
    "ContentTypeAllowlist": [
      "text/csv",
      "application/csv",
      "application/vnd.ms-excel",
      "text/plain"
    ],
    "MaxExportRows": 10000
  },
  "Swagger": {
    "Enabled": false
  },
  "Security": {
    "FrontDoor": {
      "FrontDoorId": ""
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Auth": {
    "DevBypass": {
      "Enabled": false,
      "UserId": "00000000-0000-0000-0000-000000000001",
      "DisplayName": "Local Developer",
      "Email": "dev@localhost"
    }
  },
  "Api": {
    "AllowedOrigins": []
  }
}
